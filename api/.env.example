# Copy this file to .env and fill in real values. .env itself is gitignored —
# never commit real credentials.

# Connects to the "postgres" container by its Docker Compose service name
# (not localhost, not the host-mapped 127.0.0.1:5432 port) — this only works
# when both containers are on the same Docker network, which Compose does
# automatically for services in the same file.
DATABASE_URL=postgresql+psycopg://vedlakshana_app:Shiv@248@postgres:5432/vedlakshana

# Must match WRITE_TOKEN in index.html exactly, or every save will be
# rejected with 401.
WRITE_TOKEN=siddhnathmahadevkijay

# Only this origin is allowed to call the API (CORS).
ALLOWED_ORIGIN=https://vijayfive.github.io

# "production" hides the auto-generated /docs page; set to "development"
# locally if you want to browse http://localhost:8000/docs while testing.
ENV=production
